# ---------------------------------------------------------------------------
# Web app configuration. Copy to .env.local and adjust.
# Validated by src/config/env.ts at startup, so a bad value fails immediately.
# ---------------------------------------------------------------------------

# Base URL of the FastAPI backend. The /api/v1 prefix is added by the app.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Shown in the browser tab, the sidebar and the auth screens.
NEXT_PUBLIC_APP_NAME=Logistic One CRM

# Auth session strategy (locked for v1)
# ------------------------------------
# Login is exchanged by the Next route handlers under /api/auth, which set an
# httpOnly cookie. The browser never holds the access token, so every request to
# FastAPI goes through the proxy at /api/crm. Nothing else is supported: do not
# add a client-side token store alongside this.

# Mock mode. When true, /api/auth/* and the modules that have a mock handler
# (users, audit) are served by an in-memory tenant instead of FastAPI, so each
# shipped slice is clickable before the backend is running. Endpoints for
# modules that have not been mocked yet return 501 rather than looking empty.
# Seeded accounts, all with password Sprint1demo!:
#   admin@calderfreight.test    Administrator
#   manager@calderfreight.test  Sales manager
#   rep@calderfreight.test      Sales representative
#   finance@calderfreight.test  Read only
NEXT_PUBLIC_USE_MOCK_API=true
