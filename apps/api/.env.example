# ---------------------------------------------------------------------------
# CRM API configuration. Copy to .env and adjust.
# Validated by src/crm/core/config.py at startup.
# ---------------------------------------------------------------------------

APP_NAME=CRM API
ENVIRONMENT=local
DEBUG=true

# Async driver for the app. Alembic derives its own sync URL from this.
DATABASE_URL=postgresql+asyncpg://postgres@localhost:5432/crm_dev
DATABASE_ECHO=false

REDIS_URL=redis://localhost:6379/0

# Comma separated. The web app calls the API server side, so this matters only
# for tools and clients pointed straight at the API.
CORS_ORIGINS=http://localhost:3000

# When running through docker compose, the service names replace localhost:
# DATABASE_URL=postgresql+asyncpg://crm:crm@db:5432/crm
# REDIS_URL=redis://redis:6379/0
